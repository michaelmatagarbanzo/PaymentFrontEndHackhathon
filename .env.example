VITE_AZURE_CLIENT_ID=
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_AZURE_SCOPES=api://<api-app-id>/access_as_user
VITE_AZURE_REDIRECT_URI=http://localhost:5173
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

VITE_PAYMENTS_API_BASE_URL=http://localhost:7071
VITE_PAYMENTS_API_KEY=dev-functions-key
VITE_PAYMENTS_CURRENCY=USD

# Sale API (appgateway-hackhathon-api) — SOLO server-side, usadas por el proxy
# /api/v1/sales en vite.config.ts (devApiPlugin) en dev, y por
# sales-proxy-function/ (Application Settings de la Function App) en prod.
# Sin prefijo VITE_ a proposito: si llevaran VITE_, Vite las incrustaria en el
# bundle del navegador y el Client Secret quedaria expuesto a cualquiera que
# abra devtools.
AZURE_SALES_TENANT_ID=754d6f21-67a5-4063-be7a-ac70991f2bd8
AZURE_SALES_CLIENT_ID=
AZURE_SALES_CLIENT_SECRET=
AZURE_SALES_API_BASE_URL=https://appgateway-hackhathon-api.azurewebsites.net

# URL del sales-proxy-function ya desplegado. Vacio = usa el proxy local de
# vite.config.ts (npm run dev). Solo hace falta en el build de produccion.
VITE_SALES_PROXY_URL=
